# Financial Modeling Prep API key (free tier: https://site.financialmodelingprep.com/developer/docs)
FMP_API_KEY=your_fmp_key_here

# Anthropic API key, used to summarize Fed statements with Claude Haiku
ANTHROPIC_API_KEY=your_anthropic_key_here

# --- storage ---
# SQLite by default, so the app runs with no signups. Set this to a Postgres
# connection string in production: anything deployed on a free instance loses
# a local file on every restart, and accounts with it.
#   DATABASE_URL=postgresql://user:pass@host/dbname
DATABASE_URL=sqlite:///vantage.db

# Hours fundamentals data stays cached before a page load refetches it
FUNDAMENTALS_CACHE_HOURS=24

# Comma-separated list of frontend origins allowed to call this API
# (browsers block cross-origin requests unless the API explicitly allows them).
# "*" allows any origin, but then sign-in is disabled: a session cookie plus
# any-origin would let any website on the internet read a signed-in reader's
# watchlist, and browsers refuse that combination outright. The app notices
# and runs signed out rather than failing every request.
# Name your site here to turn accounts on. A wildcard subdomain works too:
#   CORS_ORIGINS=https://*.onrender.com
# where "*" stands for exactly one label.
CORS_ORIGINS=http://localhost:5173

# Order in which market-data providers are tried for quotes, price history and
# search. Yahoo Finance needs no key and has no published quota, so it goes
# first and FMP is the fallback. Set to "fmp" to turn Yahoo off.
# Fundamentals always come from FMP.
PROVIDER_ORDER=yahoo,fmp

# --- accounts and email ---
# Where sign-in links point back to: the site's address, not this API's.
APP_BASE_URL=http://localhost:5173

# Any SMTP provider works (Resend, SendGrid, Mailgun, Postmark, Gmail).
# Left unset, emails are written to the server log instead of sent, so local
# development needs no mail account at all.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Vantage <onboarding@resend.dev>

# Shared secret for the scheduled alert sweep (POST /api/notify/sweep), so
# only your scheduler can trigger it. Unset means the sweep is turned off.
CRON_SECRET=

# How long a sign-in link and a session last.
MAGIC_LINK_TTL_MINUTES=20
SESSION_TTL_DAYS=60
